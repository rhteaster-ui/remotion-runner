{
  "name": "rhmt-review",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Gemini4 out/gemini4.mp4",
    "render:erekap": "remotion render ERekapPremium out/erekap-premium.mp4 --crf=16",
    "still:erekap": "remotion still ERekapPremium out/erekap-thumb.png --frame=150",
    "sfx": "python3 pipeline/build_sfx_erekap.py",
    "render:preview": "remotion render RhmtReview out/preview.mp4 --scale=0.5 --crf=30",
    "still": "remotion still RhmtReview out/thumb.png --frame=300",
    "assets": "bash scripts/pull-assets.sh"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/layout-utils": "^4.0.540",
    "@remotion/noise": "^4.0.540",
    "@remotion/shapes": "^4.0.540",
    "@remotion/transitions": "^4.0.540",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
